{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "importHelpers": true,
    "lib": [
      "DOM",
      "ES6"
    ]
  },
  "include": [
    "src/**/*.ts",
    "main.ts"
  ],
  "exclude": [
    "reference/**/*",
    "node_modules/**/*",
    "**/*.test.ts",
    "**/__tests__/**/*"
  ]
}